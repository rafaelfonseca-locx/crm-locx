{
	"name": "@crm-locx/api",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "prisma generate && tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "tsx prisma/seed.ts",
		"db:reset": "prisma migrate reset --force"
	},
	"prisma": { "seed": "tsx prisma/seed.ts" },
	"dependencies": {
		"@prisma/client": "6.19.3",
		"bcryptjs": "3.0.2",
		"cors": "2.8.5",
		"dotenv": "16.4.7",
		"express": "5.1.0",
		"helmet": "8.1.0",
		"jsonwebtoken": "9.0.2",
		"morgan": "1.10.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@types/cors": "2.8.17",
		"@types/express": "5.0.1",
		"@types/jsonwebtoken": "9.0.9",
		"@types/morgan": "1.9.9",
		"@types/node": "22.15.3",
		"@types/supertest": "6.0.3",
		"prisma": "6.19.3",
		"supertest": "7.1.4",
		"tsx": "4.19.4",
		"typescript": "5.8.3",
		"vitest": "3.1.2"
	}
}
