{
	"name": "crm-locx",
	"private": true,
	"version": "0.1.0",
	"description": "CRM comercial da LocX: do lead do RD Station à venda, com acompanhamento de trial",
	"workspaces": [
		"apps/api",
		"apps/web"
	],
	"scripts": {
		"dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
		"dev:api": "npm run dev --workspace apps/api",
		"dev:web": "npm run dev --workspace apps/web",
		"build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
		"test": "npm run test --workspace apps/api",
		"db:migrate": "npm run db:migrate --workspace apps/api",
		"db:seed": "npm run db:seed --workspace apps/api",
		"lint": "biome check apps",
		"db:clear": "npm run db:clear --workspace apps/api",
		"db:import": "npm run db:import --workspace apps/api --"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"concurrently": "9.1.2"
	},
	"engines": {
		"node": ">=20"
	}
}
