// Modelo de dados do CRM LocX.
// Fluxo: lead chega (RD Station ou manual) → pré-atendimento → reunião → trial (5 a 7 dias) → venda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
}

enum LeadStage {
  NEW // Novo lead
  QUALIFICATION // Pré-atendimento (SDR)
  MEETING // Reunião
  TRIAL // Trial
  CLOSING // Venda (negociação/fechamento)
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum ParticipantRole {
  SDR
  CLOSER
  ONBOARDING
  TECHNICAL
  OBSERVER
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  TASK
  STAGE_CHANGE
  SYSTEM
}

enum LeadChannel {
  DEMO // Agendou demonstração (formulário completo + Cal.com)
  WHATSAPP // Formulário do WhatsApp: exige pré-atendimento
  SITE // Formulário da página
  MANUAL // Cadastro manual, indicação, evento...
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum TrialStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(SALES)
  color          String    @default("#FFCC00")
  avatarUrl      String?
  // Primeiro acesso: obriga a trocar a senha inicial
  mustChangePassword Boolean   @default(false)
  onboardedAt    DateTime?
  active         Boolean   @default(true)
  // Participa do rodízio de distribuição de leads vindos do RD Station
  receivesLeads  Boolean   @default(true)
  lastAssignedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ownedLeads     Lead[]               @relation("LeadOwner")
  participations LeadParticipant[]
  activities     Activity[]           @relation("ActivityAuthor")
  assignedTasks  Activity[]           @relation("ActivityAssignee")
  stageEvents    StageEvent[]
  checklistDone  TrialChecklistItem[]
}

model Lead {
  id             Int              @id @default(autoincrement())
  name           String
  email          String?
  phone          String?
  jobTitle       String?
  companyName    String?
  companySize    String?
  segment        String?
  website        String?
  city           String?
  state          String?
  stage          LeadStage        @default(NEW)
  status         LeadStatus       @default(OPEN)
  temperature    LeadTemperature?
  // Valor mensal estimado (MRR) da oportunidade
  estimatedValue Decimal?         @db.Decimal(12, 2)
  plan           String?
  billingCycle   BillingCycle?
  notes          String?
  tags           String[]         @default([])

  // Qualificação (perguntas padronizadas dos formulários)
  businessType   String? // Perfil / qualificação do negócio
  managementRole String? // Papel na gestão dos imóveis
  contractsRange String? // Quantos contratos de aluguel administra
  currentTool    String? // Como gerencia hoje
  startTimeline  String? // Quando pretende começar

  // Origem
  channel              LeadChannel @default(MANUAL)
  source               String      @default("Manual")
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  conversionIdentifier String?
  conversionCount      Int     @default(1)
  rdLeadId             String? @unique
  rdPublicUrl          String?

  lostReason     String?
  ownerId        String?
  owner          User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageChangedAt DateTime  @default(now())
  wonAt          DateTime?
  lostAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  participants LeadParticipant[]
  activities   Activity[]
  trial        Trial?
  stageEvents  StageEvent[]

  @@index([stage, status])
  @@index([ownerId])
  @@index([email])
  @@index([createdAt])
  @@index([channel])
}

// Outras pessoas adicionadas ao processo de um lead, além do responsável
model LeadParticipant {
  id        String          @id @default(cuid())
  leadId    Int
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ParticipantRole @default(OBSERVER)
  createdAt DateTime        @default(now())

  @@unique([leadId, userId])
}

model Activity {
  id          String       @id @default(cuid())
  leadId      Int
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        ActivityType
  title       String?
  body        String?
  // Tarefas e reuniões têm data; as demais atividades são registros
  dueAt       DateTime?
  completedAt DateTime?
  meetingUrl  String?
  // Id do agendamento no Cal.com, para remarcar e cancelar
  externalId  String?      @unique
  metadata    Json?
  authorId    String?
  author      User?        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([leadId, createdAt])
  @@index([assigneeId, dueAt])
}

model Trial {
  id         String               @id @default(cuid())
  leadId     Int                  @unique
  lead       Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  status     TrialStatus          @default(ACTIVE)
  // Link ou identificador da conta de teste no produto
  accountUrl String?
  notes      String?
  checklist  TrialChecklistItem[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status, endDate])
}

model TrialChecklistItem {
  id        String    @id @default(cuid())
  trialId   String
  trial     Trial     @relation(fields: [trialId], references: [id], onDelete: Cascade)
  dayOffset Int
  title     String
  position  Int
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneById  String?
  doneBy    User?     @relation(fields: [doneById], references: [id], onDelete: SetNull)
}

// Histórico de mudanças de etapa e status, usado no funil e nos relatórios
model StageEvent {
  id         String      @id @default(cuid())
  leadId     Int
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage  LeadStage?
  toStage    LeadStage
  fromStatus LeadStatus?
  toStatus   LeadStatus
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([leadId])
  @@index([toStage, createdAt])
}

model WebhookLog {
  id        String   @id @default(cuid())
  source    String
  status    String // PROCESSED | UPDATED | ERROR
  message   String?
  leadId    Int?
  payload   Json
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
