# Conexão com o PostgreSQL
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
# Porta da API
PORT=3333
# Segredo para assinar os tokens de login (troque em produção)
JWT_SECRET="troque-este-segredo"
# Origem do front-end (CORS)
WEB_ORIGIN="http://localhost:5173"
# Token que o RD Station envia na URL do webhook (?token=...)
RD_WEBHOOK_TOKEN="troque-este-token"
# URL pública da API, usada para montar a URL do webhook exibida na tela de integrações
PUBLIC_API_URL="http://localhost:3333"
# Opcional: "secret" configurado no webhook do Cal.com (valida a assinatura x-cal-signature-256)
CAL_WEBHOOK_SECRET=

# ---------- E-mail (opcional) ----------
# Sem SMTP_HOST os avisos ficam só no sininho do sistema.
# Google Workspace (relay SMTP): SMTP_HOST=smtp-relay.gmail.com, SMTP_PORT=587
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=resend, SMTP_PASS=<chave>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LocX CRM <crm@locx.com.br>"
APP_TIMEZONE=America/Sao_Paulo

# ---------- Google Agenda, Meet e transcrições (opcional) ----------
# Credenciais OAuth de um projeto no Google Cloud (tipo "Aplicativo da Web").
# URI de redirecionamento autorizado: <PUBLIC_API_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Resumo das reuniões com IA (opcional) ----------
ANTHROPIC_API_KEY=

# ---------- App do RD Station (opcional) ----------
# URL de retorno do app: <PUBLIC_API_URL>/api/integrations/rd-station/callback
RD_CLIENT_ID=
RD_CLIENT_SECRET=
